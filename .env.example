# ============================================
# WA API Billey — Environment Variables
# ============================================

# Port server (default: 3000)
PORT=3000

# API Key untuk endpoint /api/wa/*
# Isi dengan nilai rahasia yang sama dengan "wa_api_token" di pengaturan Jokiin
WA_API_KEY=ganti_dengan_api_key_rahasia_anda

# ── CRM Sync (Jokiin) ──
# URL API Jokiin CRM (kosongkan jika tidak sync)
CRM_API_URL=http://localhost:8000/api
# Token dari env AUTOMATION_API_TOKEN di Jokiin
CRM_API_TOKEN=ganti_dengan_automation_api_token

# Node environment
NODE_ENV=production
